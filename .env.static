# Every variable the stack reads, loaded by every service (compose `env_file`), followed by the
# gitignored `.env`, which holds real secrets and local overrides and wins on conflicts.
#
# - Non-secret values are filled in here, including local-only passwords.
# - Secrets are placeholders, NAME="[SECRET] <where to get it>". `task validate` (run by `task up`
#   and the build tasks) fails and names each one that `.env` doesn't set.
#
# Compose itself reads a few more, so they go in `.env` or the shell, not here: MSR_DATA_DIR (the
# host path mounted at /data, default ./data; inside containers it is always /data), MSR_WEB_PORT
# (web's port on 127.0.0.1, default 3000), and MSR_CPU_WORKERS / MSR_SEARCH_WORKERS (how many
# worker-cpu and worker-search containers, default 1 each).

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=STANDARD

# Threads per walk (concepts in worker-cpu, X′ in the builder); empty means half the CPUs, which
# leaves room for the rest of the stack. Each worker-cpu container (MSR_CPU_WORKERS) walks with
# this many threads.
MSR_WALK_THREADS=

# Postgres. The superuser is used only by the migration runner's bootstrap (001_postgres/);
# POSTGRES_DB is the maintenance database it connects to, and the runner creates MSR_DB_NAME.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-local
POSTGRES_DB=postgres

# The application database and its login roles. Each service logs in as
# msr_<service>_${MSR_ENV} (data_reader_${MSR_ENV} for ad-hoc reads); the passwords are local-only.
# Python services connect when MSR_DB_HOST is set (native runs leave it unset).
MSR_ENV=local
MSR_DB_HOST=postgres
MSR_DB_PORT=5432
MSR_DB_NAME=msr
MSR_DB_OWNER_PASSWORD=owner-local
MSR_DB_API_PASSWORD=api-local
MSR_DB_WORKER_PASSWORD=worker-local
MSR_DB_BUILDER_PASSWORD=builder-local
MSR_DB_READER_PASSWORD=reader-local

# Redis (per-job progress streams)
MSR_REDIS_URL=redis://redis:6379/0

# RabbitMQ (Celery broker). MSR_BROKER_HOST and the RABBITMQ_DEFAULT_* values make the broker URL.
MSR_BROKER_HOST=rabbitmq
RABBITMQ_DEFAULT_USER=msr
RABBITMQ_DEFAULT_PASS=rabbitmq-local
RABBITMQ_DEFAULT_VHOST=msr
